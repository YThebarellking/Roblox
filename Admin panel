-- Air Walk
H.airWalkBtn = createToggleButton("Air Walk", playerContainer, yOffset)
yOffset = yOffset + 46

H.airWalkPlatform = nil
H.airWalkHeight = nil

local function disableAirWalk()
    if H.airWalkPlatform then
        H.airWalkPlatform:Destroy()
        H.airWalkPlatform = nil
    end
    H.airWalkHeight = nil
end

local function enableAirWalk()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    if not root or not hum then
        return false
    end

    if H.flyEnabled then
        H.flyEnabled = false
        flyBtn.Text = "Fly [OFF]"
        flyBtn.TextColor3 = Color3.fromRGB(200, 50, 50)
        if bg then bg:Destroy() bg = nil end
        if bv then bv:Destroy() bv = nil end
        tpwalking = false
        hum.PlatformStand = false
        if char:FindFirstChild("Animate") then
            char.Animate.Disabled = false
        end
    end

    disableAirWalk()

    H.airWalkHeight = root.Position.Y
    local platform = Instance.new("Part")
    platform.Name = "DaryllHub_AirWalk"
    platform.Size = Vector3.new(5, 0.5, 5)
    platform.Anchored = true
    platform.CanCollide = true
    platform.CanTouch = false
    platform.CanQuery = false
    platform.Transparency = 1
    platform.CastShadow = false
    platform.CFrame = CFrame.new(root.Position.X, H.airWalkHeight - 3.2, root.Position.Z)
    platform.Parent = workspace
    H.airWalkPlatform = platform

    return true
end

H.airWalkBtn.MouseButton1Click:Connect(function()
    if not H.airWalkEnabled then
        H.airWalkEnabled = true
        if enableAirWalk() then
            H.airWalkBtn.Text = "Air Walk [ON]"
            H.airWalkBtn.TextColor3 = Color3.fromRGB(50, 200, 50)
        else
            H.airWalkEnabled = false
            H.airWalkBtn.Text = "Air Walk [OFF]"
            H.airWalkBtn.TextColor3 = Color3.fromRGB(200, 50, 50)
        end
    else
        H.airWalkEnabled = false
        H.airWalkBtn.Text = "Air Walk [OFF]"
        H.airWalkBtn.TextColor3 = Color3.fromRGB(200, 50, 50)
        disableAirWalk()
    end
end)

H.airWalkConnection = runService.Heartbeat:Connect(function()
    if not H.airWalkEnabled then return end

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root or H.airWalkHeight == nil then return end

    if not H.airWalkPlatform or not H.airWalkPlatform.Parent then
        if not enableAirWalk() then return end
    end

    -- Жёстко удерживаем исходную высоту и не даём гравитации уводить персонажа вниз.
    local position = root.Position
    if math.abs(position.Y - H.airWalkHeight) > 0.05 then
        local rx, ry, rz = root.CFrame:ToOrientation()
        root.CFrame =
            CFrame.new(position.X, H.airWalkHeight, position.Z) *
            CFrame.fromOrientation(rx, ry, rz)
    end

    local velocity = root.AssemblyLinearVelocity
    root.AssemblyLinearVelocity = Vector3.new(velocity.X, 0, velocity.Z)

    if H.airWalkPlatform then
        H.airWalkPlatform.CFrame = CFrame.new(root.Position.X, H.airWalkHeight - 3.2, root.Position.Z)
    end
end)
trackConnection(H.airWalkConnection)

