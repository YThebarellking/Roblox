-- Settings Controls Helper
local function createSettingsToggle(text, yPos, defaultState, onClick)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 32)
    btn.Position = UDim2.new(0, 0, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(28, 28, 30)
    btn.Text = text .. (defaultState and " [ON]" or " [OFF]")
    btn.TextColor3 = defaultState and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(239, 68, 68)
    btn.TextSize = 11
    btn.Font = Enum.Font.GothamBold
    btn.ZIndex = 11
    btn.Parent = settingsContent
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(45, 45, 48)
    stroke.Thickness = 1
    stroke.Parent = btn
    table.insert(themeableElements.Borders, stroke)
    table.insert(themeableElements.Buttons, btn)

    local state = defaultState
    local conn = btn.MouseButton1Click:Connect(function()
        state = not state
        btn.Text = text .. (state and " [ON]" or " [OFF]")
        btn.TextColor3 = state and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(239, 68, 68)
        onClick(state)
    end)
    addConnection(conn)
    return btn
end

