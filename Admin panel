    label.TextStrokeTransparency = 0
    label.Visible = false
    label.Parent = H.offscreenGui
    H.offscreenLabels[p] = label
    return label
end
H.removeOffscreenIndicator = function(p)
    local label = H.offscreenLabels[p]
    if label then label:Destroy() H.offscreenLabels[p] = nil end
end
H.updateOffscreenIndicator = function(p, viewportSize)
    if p == player or not p.Character then H.removeOffscreenIndicator(p) return end
    local root = p.Character:FindFirstChild("HumanoidRootPart")
    local label = H.getOffscreenLabel(p)
    if not root then label.Visible = false return end
    local point, onScreen = camera:WorldToViewportPoint(root.Position)
    if onScreen and point.Z > 0 then label.Visible = false return end
    local center = Vector2.new(viewportSize.X * 0.5, viewportSize.Y * 0.5)
    local target = Vector2.new(point.X, point.Y)
    if point.Z < 0 then target = center - (target - center) end
    local dir = target - center
    if dir.Magnitude < 0.001 then dir = Vector2.new(0, -1) else dir = dir.Unit end
    local margin = 28
    local halfW = math.max(1, viewportSize.X * 0.5 - margin)
    local halfH = math.max(1, viewportSize.Y * 0.5 - margin)
    local tx = math.huge
    local ty = math.huge
    if math.abs(dir.X) > 0.001 then tx = halfW / math.abs(dir.X) end
    if math.abs(dir.Y) > 0.001 then ty = halfH / math.abs(dir.Y) end
    local pos = center + dir * math.min(tx, ty)
    label.Position = UDim2.fromOffset(pos.X, pos.Y)
    label.TextColor3 = H.teamColorForPlayer(p)
    label.Rotation = math.deg(math.atan2(dir.Y, dir.X)) + 90
    label.Visible = true
end
