    xrayEnabled = false
    flyEnabled = false
    infiniteJumpEnabled = false
    invisibleEnabled = false
    clickTpEnabled = false
    antiRagdollEnabled = false
    antiKnockbackEnabled = false
    antiSitEnabled = false
    antiSlowEnabled = false
    antiFlingEnabled = false
    antiAfkEnabled = false
    autoTeleportEnabled = false
    noFogEnabled = false
    fullbrightEnabled = false
    tracersEnabled = false
    lightEnabled = false
    H.airWalkEnabled = false
    H.freezeCharacterEnabled = false
    spectatingPlayer = nil

    if infiniteJumpConnection then infiniteJumpConnection:Disconnect() infiniteJumpConnection = nil end
    if clickTpConnection then clickTpConnection:Disconnect() clickTpConnection = nil end
    if godLoop then godLoop:Disconnect() godLoop = nil end
    if noclipLoop then noclipLoop:Disconnect() noclipLoop = nil end
    if xrayLoop then xrayLoop:Disconnect() xrayLoop = nil end
    if noFogLoop then noFogLoop:Disconnect() noFogLoop = nil end
    if fullbrightLoop then fullbrightLoop:Disconnect() fullbrightLoop = nil end
    if tracersLoop then tracersLoop:Disconnect() tracersLoop = nil end
    if antiFlingLoop then antiFlingLoop:Disconnect() antiFlingLoop = nil end
    if antiAfkConnection then antiAfkConnection:Disconnect() antiAfkConnection = nil end
    if antiRagdollLoop then antiRagdollLoop:Disconnect() antiRagdollLoop = nil end
    if antiKnockbackLoop then antiKnockbackLoop:Disconnect() antiKnockbackLoop = nil end
    if antiSitLoop then antiSitLoop:Disconnect() antiSitLoop = nil end
    if antiSlowLoop then antiSlowLoop:Disconnect() antiSlowLoop = nil end
    if touchFlingConnection then touchFlingConnection:Disconnect() touchFlingConnection = nil end
    touchFlingStartPos = nil
    if H.mainPositionConnection then H.mainPositionConnection:Disconnect() H.mainPositionConnection = nil end

    for _, connection in ipairs(H.uiConnections) do
        pcall(function() connection:Disconnect() end)
    end
    table.clear(H.uiConnections)

    if H.airWalkPlatform then
        H.airWalkPlatform:Destroy()
        H.airWalkPlatform = nil
    end

    if invisChair then invisChair:Destroy() invisChair = nil end
    if invisConnection then invisConnection:Disconnect() invisConnection = nil end
    if player.Character then
        pcall(function() setCharacterTransparency(player.Character, 0) end)
    end
    if bg then bg:Destroy() bg = nil end
    if bv then bv:Destroy() bv = nil end
    tpwalking = false

    if player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
        local hum = player.Character:FindFirstChildOfClass("Humanoid")
        hum.PlatformStand = false
        hum.UseJumpPower = true
        hum.AutoRotate = true

        -- Восстанавливаем состояния Humanoid, которые мог отключить Fly.
        local statesToRestore = {
            Enum.HumanoidStateType.Climbing,
            Enum.HumanoidStateType.FallingDown,
            Enum.HumanoidStateType.Flying,
            Enum.HumanoidStateType.Freefall,
            Enum.HumanoidStateType.GettingUp,
            Enum.HumanoidStateType.Jumping,
            Enum.HumanoidStateType.Landed,
            Enum.HumanoidStateType.Physics,
            Enum.HumanoidStateType.PlatformStanding,
            Enum.HumanoidStateType.Ragdoll,
            Enum.HumanoidStateType.Running,
            Enum.HumanoidStateType.RunningNoPhysics,
            Enum.HumanoidStateType.Seated,
            Enum.HumanoidStateType.StrafingNoPhysics,
            Enum.HumanoidStateType.Swimming,
        }
        for _, state in ipairs(statesToRestore) do
            pcall(function() hum:SetStateEnabled(state, true) end)
        end

        local animate = player.Character:FindFirstChild("Animate")
        if animate then
            animate.Disabled = false
        end

        if spectatingPlayer == nil then
            camera.CameraSubject = hum
        end

        -- Убираем остатки Noclip/Freeze.
        for _, part in ipairs(player.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
                part.Anchored = false
            end
        end
    end

    player.CameraMinZoomDistance = 0.5
    player.CameraMaxZoomDistance = 128

    pcall(function()
        lighting.FogStart = origFogStart
        lighting.FogEnd = origFogEnd
        lighting.Ambient = origAmbient
        lighting.OutdoorAmbient = origOutdoorAmbient
        restoreScreenEffects()
    end)

    pcall(clearTracers)
    pcall(function()
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local light = root and root:FindFirstChild("DaryllLight")
        if light then light:Destroy() end
    end)
    screenGui:Destroy()
end

