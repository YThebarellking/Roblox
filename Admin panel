    State.Player.ClickTP = not State.Player.ClickTP

    setButtonState(
        ClickTPButton,
        "Click TP",
        State.Player.ClickTP
    )

    if State.Player.ClickTP then
        connect(
            "ClickTP",
            UserInputService.InputBegan,
            function(input, processed)
                if processed or not State.Player.ClickTP then
                    return
                end

                local valid =
                    input.UserInputType == Enum.UserInputType.MouseButton1
                    and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)

                if not valid then
                    return
                end

                local mousePos = input.Position
                local ray = Camera:ScreenPointToRay(
                    mousePos.X,
                    mousePos.Y
                )

                local result = workspace:Raycast(
                    ray.Origin,
                    ray.Direction * 2000
                )

                if result then
                    local character = getCharacter()

                    if character then
                        character:MoveTo(
                            result.Position + Vector3.new(0, 3, 0)
                        )
                    end
                end
            end
        )
    else
        disconnect("ClickTP")
    end
end)

