local function isEquipAnimationTrack(track)
    if not track then return false end
    local name = string.lower(track.Name or "")
    return name:find("tool", 1, true) ~= nil
        or name:find("equip", 1, true) ~= nil
        or name:find("hold", 1, true) ~= nil
end

local function setEquipCheatPose(character, enabled)
    if not character then return end

    local shoulderNames = {
        ["LeftShoulder"] = true,
        ["RightShoulder"] = true,
        ["Left Shoulder"] = true,
        ["Right Shoulder"] = true,
    }

    for _, obj in ipairs(character:GetDescendants()) do
        if obj:IsA("Motor6D") and shoulderNames[obj.Name] then
            if enabled then
                obj.Transform = CFrame.new()
            elseif H.equipCheatShoulders[obj] then
                obj.Transform = H.equipCheatShoulders[obj]
            end
        end
    end
end

local function suppressEquipAnimations(character)
    local hum = character and character:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if not animator then return end

    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        if isEquipAnimationTrack(track) then
            pcall(function() track:Stop(0) end)
        end
    end
end

local function disconnectEquipCheat()
    if H.equipCheatConnection then
        H.equipCheatConnection:Disconnect()
        H.equipCheatConnection = nil
    end
    if H.equipCheatLoop then
        H.equipCheatLoop:Disconnect()
        H.equipCheatLoop = nil
    end
    for motor, saved in pairs(H.equipCheatShoulders) do
        if motor and motor.Parent then
            pcall(function() motor.Transform = saved end)
        end
    end
    table.clear(H.equipCheatShoulders)
end

local function bindEquipCheat(character)
    disconnectEquipCheat()
    if not H.equipCheatEnabled or not character then return end

    for _, obj in ipairs(character:GetDescendants()) do
        if obj:IsA("Motor6D") then
            local n = obj.Name
            if n == "LeftShoulder" or n == "RightShoulder"
                or n == "Left Shoulder" or n == "Right Shoulder" then
                H.equipCheatShoulders[obj] = obj.Transform
            end
        end
    end

    local hum = character:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if animator then
        H.equipCheatConnection = animator.AnimationPlayed:Connect(function(track)
            if H.equipCheatEnabled and isEquipAnimationTrack(track) then
                task.defer(function()
                    if track and track.IsPlaying then
                        pcall(function() track:Stop(0) end)
                    end
                end)
            end
        end)
        trackConnection(H.equipCheatConnection)
    end

    H.equipCheatLoop = runService.RenderStepped:Connect(function()
        if not H.equipCheatEnabled then return end
        local char = player.Character
        if not char then return end
        local toolEquipped = char:FindFirstChildOfClass("Tool") ~= nil
        if toolEquipped then
            setEquipCheatPose(char, true)
            suppressEquipAnimations(char)
        else
            setEquipCheatPose(char, false)
        end
    end)
    trackConnection(H.equipCheatLoop)
end

