local function createSlider(
    text,
    parent,
    y,
    minimum,
    maximum,
    defaultValue,
    step,
    callback
)
    local frame = Instance.new("Frame")

    frame.Size = UDim2.new(0.92, 0, 0, 38)
    frame.Position = UDim2.new(0.04, 0, 0, y)

    frame.BackgroundColor3 =
        Color3.fromRGB(28, 28, 30)

    frame.BorderSizePixel = 0
    frame.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = frame

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(45, 45, 48)
    stroke.Thickness = 1
    stroke.Parent = frame

    local label = Instance.new("TextLabel")

    label.Size = UDim2.new(0.52, 0, 1, 0)
    label.Position = UDim2.new(0.03, 0, 0, 0)

    label.BackgroundTransparency = 1

    label.TextColor3 =
        Color3.fromRGB(230, 230, 230)

    label.TextSize = 11
    label.TextXAlignment =
        Enum.TextXAlignment.Left

    label.Font = Enum.Font.GothamMedium
    label.Parent = frame

    local minus = Instance.new("TextButton")

    minus.Size = UDim2.new(0.18, 0, 0.7, 0)
    minus.Position = UDim2.new(0.60, 0, 0.15, 0)

    minus.BackgroundColor3 =
        Color3.fromRGB(40, 40, 44)

    minus.BorderSizePixel = 0
    minus.Text = "-"
    minus.TextColor3 =
        Color3.fromRGB(255, 255, 255)

    minus.TextSize = 14
    minus.Font = Enum.Font.GothamBold
    minus.Parent = frame

    local minusCorner = Instance.new("UICorner")
    minusCorner.CornerRadius =
        UDim.new(0, 4)

    minusCorner.Parent = minus

    local plus = Instance.new("TextButton")

    plus.Size = UDim2.new(0.18, 0, 0.7, 0)
    plus.Position = UDim2.new(0.80, 0, 0.15, 0)

    plus.BackgroundColor3 =
        Color3.fromRGB(40, 40, 44)

    plus.BorderSizePixel = 0
    plus.Text = "+"
    plus.TextColor3 =
        Color3.fromRGB(255, 255, 255)

    plus.TextSize = 14
    plus.Font = Enum.Font.GothamBold
    plus.Parent = frame

    local plusCorner = Instance.new("UICorner")
    plusCorner.CornerRadius =
        UDim.new(0, 4)

    plusCorner.Parent = plus

    local value = defaultValue

    local function formatValue(number)
        if step < 1 then
            return string.format("%.1f", number)
        end

        return tostring(math.floor(number + 0.5))
    end

    local function setValue(newValue)
        newValue = math.clamp(
            newValue,
            minimum,
            maximum
        )

        if step < 1 then
            newValue =
                math.floor(
                    (newValue / step) + 0.5
                ) * step

            newValue =
                math.floor(
                    newValue * 10 + 0.5
                ) / 10
        else
            newValue =
                math.floor(
                    newValue / step + 0.5
                ) * step
        end

        value = newValue

        label.Text =
            text .. ": " .. formatValue(value)

        if callback then
            callback(value)
        end
    end

    plus.MouseButton1Click:Connect(function()
        setValue(value + step)
    end)

    minus.MouseButton1Click:Connect(function()
        setValue(value - step)
    end)

    setValue(defaultValue)

    return {
        Frame = frame,
        Label = label,

        GetValue = function()
            return value
        end,

        SetValue = setValue,
    }
end

