    local root = getRoot()
    local humanoid = getHumanoid()

    if not root or not humanoid then
        State.Movement.Fly = false

        setToggleVisual(
            FlyButton,
            "Fly",
            false
        )

        return
    end

    -- Отключаем Air Walk, если включен, чтобы не конфликтовать
    if State.Movement.AirWalk then
        State.Movement.AirWalk = false
        setToggleVisual(AirWalkButton, "Air Walk", false)
