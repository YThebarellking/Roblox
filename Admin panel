    if not H.windowDragStart or not H.windowDragOrigin then return end

    local delta = input.Position - H.windowDragStart
    mainFrame.Position = UDim2.new(
        H.windowDragOrigin.X.Scale,
        H.windowDragOrigin.X.Offset + delta.X,
        H.windowDragOrigin.Y.Scale,
        H.windowDragOrigin.Y.Offset + delta.Y
    )
end))

