H.freezeCharacterBtn = createToggleButton("Freeze Character", playerContainer, yOffset)
yOffset = yOffset + 46

H.freezeOriginalAnchored = {}

local function setFreezeCharacter(enabled)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    if enabled then
        if H.freezeOriginalAnchored[root] == nil then
            H.freezeOriginalAnchored[root] = root.Anchored
        end
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        root.Anchored = true
    else
        if H.freezeOriginalAnchored[root] ~= nil then
            root.Anchored = H.freezeOriginalAnchored[root]
            H.freezeOriginalAnchored[root] = nil
        else
            root.Anchored = false
        end
    end
end

H.freezeConnection = runService.Heartbeat:Connect(function()
    if not H.freezeCharacterEnabled then return end

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    root.Anchored = true
end)
