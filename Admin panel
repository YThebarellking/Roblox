        H.antiCameraLockSubject = camera.CameraSubject
        H.antiCameraLockCFrame = camera.CFrame

        H.antiCameraLockConnection = runService.RenderStepped:Connect(function()
            if not H.antiCameraLockEnabled or H.closed then return end

            if camera.CameraType ~= (H.antiCameraLockType or Enum.CameraType.Custom) then
                camera.CameraType = H.antiCameraLockType or Enum.CameraType.Custom
            end

            if H.antiCameraLockSubject and camera.CameraSubject ~= H.antiCameraLockSubject then
                camera.CameraSubject = H.antiCameraLockSubject
            end

            local current = camera.CFrame
            local previous = H.antiCameraLockCFrame
            if previous then
                local directionDot = math.clamp(previous.LookVector:Dot(current.LookVector), -1, 1)
                local angle = math.acos(directionDot)
                if angle > math.rad(32) then
                    camera.CFrame = CFrame.lookAt(
                        current.Position,
                        current.Position + previous.LookVector,
                        previous.UpVector
                    )
                    current = camera.CFrame
                end
            end

            H.antiCameraLockCFrame = current
        end)
        trackConnection(H.antiCameraLockConnection)
    else
        H.antiCameraLockType = nil
        H.antiCameraLockSubject = nil
        H.antiCameraLockCFrame = nil
    end
end)

