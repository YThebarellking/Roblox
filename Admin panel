local function getCharacter()
    return LocalPlayer.Character
end

local function getHumanoid()
    local character = getCharacter()

    if not character then
        return nil
    end

    return character:FindFirstChildOfClass("Humanoid")
end

local function getRoot()
    local character = getCharacter()

    if not character then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")
end

local function destroy(instance)
    if instance then
        pcall(function()
            instance:Destroy()
        end)
    end
end

local function setRole(instance, role)
    if instance then
        instance:SetAttribute("DaryllThemeRole", role)
    end

    return instance
end

local function setToggleVisual(button, label, enabled)
    local theme = getTheme()

    if not button then
        return
    end

    if enabled then
        button.Text = label .. " [ON]"
        button.TextColor3 = theme.Success
    else
        button.Text = label .. " [OFF]"
        button.TextColor3 = theme.Error
    end
end

