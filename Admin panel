-- Script Unload Handler
local function unloadScript()
    spectatingPlayer = nil
    spectateTargetPlayer = nil
    if camera and player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
        camera.CameraSubject = player.Character:FindFirstChildOfClass("Humanoid")
    end

    if godModeEnabled and player.Character then
        local hum = player.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
            hum.Health = 100
        end
    end

    if flyEnabled and player.Character then
        local hum = player.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
    end

    if invisibleEnabled and player.Character then
        for _, desc in ipairs(player.Character:GetDescendants()) do
            if desc:IsA("BasePart") or desc:IsA("Decal") then desc.Transparency = 0 end
        end
    end

    if cameraNoclipEnabled then
        player.CameraMinZoomDistance = 0.5
        player.CameraMaxZoomDistance = 400
    end

    for _, c in ipairs(allConnections) do c:Disconnect() end
    allConnections = {}

    if invisChair then invisChair:Destroy() invisChair = nil end
    screenGui:Destroy()
end

