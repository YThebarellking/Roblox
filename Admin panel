toggleGuiBtn.InputBegan:Connect(function(input)
    if H.closed or not H.dragButtonEnabled then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        H.buttonDragging = true
        H.buttonWasDragged = false
        H.buttonDragStart = input.Position
        H.buttonDragOrigin = toggleGuiBtn.Position
    end
end)

toggleGuiBtn.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
        H.buttonDragInput = input
    end
end)

trackConnection(userInputService.InputChanged:Connect(function(input)
    if H.closed or not H.buttonDragging or not H.dragButtonEnabled then return end
    if H.buttonDragInput and input ~= H.buttonDragInput then return end
    if not H.buttonDragStart or not H.buttonDragOrigin then return end

    local delta = input.Position - H.buttonDragStart
    if math.abs(delta.X) > 4 or math.abs(delta.Y) > 4 then
        H.buttonWasDragged = true
    end

    toggleGuiBtn.Position = UDim2.new(
        H.buttonDragOrigin.X.Scale,
        H.buttonDragOrigin.X.Offset + delta.X,
        H.buttonDragOrigin.Y.Scale,
        H.buttonDragOrigin.Y.Offset + delta.Y
    )
end))

trackConnection(userInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        H.buttonDragging = false
        H.buttonDragInput = nil
    end
end))

