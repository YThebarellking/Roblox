-- Health ESP
H.healthEspEnabled = false
H.healthEspLoop = nil

local function removeHealthEsp(p)
    if p and p.Character then
        local head = p.Character:FindFirstChild("Head")
        if head then
            local gui = head:FindFirstChild("DaryllHub_HealthESP")
            if gui then gui:Destroy() end
        end
    end
end

local function applyHealthEsp(p)
    if p == player or not p.Character then return end

    local humanoid = p.Character:FindFirstChildOfClass("Humanoid")
    local head = p.Character:FindFirstChild("Head")
    if not humanoid or not head then return end

    local gui = head:FindFirstChild("DaryllHub_HealthESP")
    if not gui then
        gui = Instance.new("BillboardGui")
        gui.Name = "DaryllHub_HealthESP"
        gui.AlwaysOnTop = true
        gui.Size = UDim2.new(0, 120, 0, 26)
        gui.StudsOffset = Vector3.new(0, 3.5, 0)
        gui.Adornee = head
        gui.Parent = head

        local label = Instance.new("TextLabel")
        label.Name = "HealthLabel"
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
        label.TextStrokeTransparency = 0
        label.TextSize = 15
        label.Font = Enum.Font.GothamBold
        label.Parent = gui
    end

    local label = gui:FindFirstChild("HealthLabel")
    if label then
        local maxHealth = math.max(humanoid.MaxHealth, 1)
        local health = math.clamp(humanoid.Health, 0, maxHealth)
        label.Text = string.format("%s: %d/%d", p.Name, math.floor(health + 0.5), math.floor(maxHealth + 0.5))
        local ratio = health / maxHealth
        if ratio > 0.6 then
            label.TextColor3 = Color3.fromRGB(50, 255, 50)
        elseif ratio > 0.3 then
            label.TextColor3 = Color3.fromRGB(255, 220, 50)
        else
            label.TextColor3 = Color3.fromRGB(255, 70, 70)
        end
    end
end

