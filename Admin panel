        State.Settings.NoLimits
    )

    setToggleVisual(
        DraggableButton,
        "Drag UI",
        State.Settings.Draggable
    )

    for name, button in pairs(ThemeButtons) do
        if name == State.Settings.Theme then
            button.BackgroundColor3 =
                theme.ButtonHover

            button.TextColor3 =
                theme.Text
        else
            button.BackgroundColor3 =
                theme.Button

            button.TextColor3 =
                theme.Muted
        end
    end
end

-- СОЗДАНИЕ КНОПОК ЦВЕТОВ С ПРАВИЛЬНЫМ ПОЗИЦИОНИРОВАНИЕМ
local themeOrder = {
    "Black",
    "Orange",
    "Blue",
    "Purple",
    "Pink",
}

for index, themeName in ipairs(themeOrder) do
    local button = Instance.new("TextButton")

    button.Name = themeName .. "Theme"

    button.Size = UDim2.new(0.46, 0, 0, 34)

    local column = (index - 1) % 2
    local row = math.floor((index - 1) / 2)

    button.Position = UDim2.new(
        0.04 + column * 0.50,
        0,
        0,
        SettingsY + row * 40
    )

    button.BorderSizePixel = 0
    button.Text = ThemeDisplayNames[themeName]
    button.TextSize = 11
    button.Font = Enum.Font.GothamBold
    button.TextXAlignment = Enum.TextXAlignment.Center

    button.Parent = SettingsOverlay
    setRole(button, "Button")

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = button

    ThemeButtons[themeName] = button

    button.MouseButton1Click:Connect(function()
        State.Settings.Theme = themeName
        applyTheme()
    end)
end

