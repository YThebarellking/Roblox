y = y + 46

local ANTI_FLING_MAX_LINEAR_VELOCITY = 100
local ANTI_FLING_MAX_ANGULAR_VELOCITY = 100

local function applyAntiFling()
    if not State.Anti.AntiFling then
        return
    end

    local root = getRoot()
    if not root then
        return
    end

    local linear = root.AssemblyLinearVelocity
    local angular = root.AssemblyAngularVelocity

    local linearMagnitude = linear.Magnitude
    local angularMagnitude = angular.Magnitude

    if linearMagnitude > ANTI_FLING_MAX_LINEAR_VELOCITY then
        local clamped = linear / linearMagnitude * ANTI_FLING_MAX_LINEAR_VELOCITY
        root.AssemblyLinearVelocity = clamped
    end

    if angularMagnitude > ANTI_FLING_MAX_ANGULAR_VELOCITY then
        local clamped = angular / angularMagnitude * ANTI_FLING_MAX_ANGULAR_VELOCITY
        root.AssemblyAngularVelocity = clamped
    end
end

