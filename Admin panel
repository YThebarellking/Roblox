        XRayCharacterConnections[player]:Disconnect()
        XRayCharacterConnections[player] = nil
    end
end

local function createXRay(player)
    if player == LocalPlayer then
        return
    end

    if not player.Character then
        return
    end

    removeXRay(player)

    local highlight = Instance.new("Highlight")

    highlight.Name =
        "DaryllXRay"

    highlight.Adornee =
        player.Character

    highlight.DepthMode =
        Enum.HighlightDepthMode.AlwaysOnTop

    highlight.FillColor =
        Color3.fromRGB(255, 60, 60)

    highlight.FillTransparency =
        0.45

    highlight.OutlineColor =
        Color3.fromRGB(255, 255, 255)

    highlight.OutlineTransparency =
        0

    highlight.Parent =
        ScreenGui

    XRayHighlights[player] =
        highlight
end

local function watchXRayPlayer(player)
    if player == LocalPlayer then
        return
    end

    removeXRayConnection(player)

    XRayCharacterConnections[player] =
        player.CharacterAdded:Connect(
            function()
                if State.Visual.XRay then
                    task.wait(0.2)
                    createXRay(player)
                end
            end
        )

    if State.Visual.XRay then
        createXRay(player)
    end
end

local function clearXRay()
    for player in pairs(XRayHighlights) do
        removeXRay(player)
    end

    for player in pairs(
        XRayCharacterConnections
    ) do
        removeXRayConnection(player)
    end
end

