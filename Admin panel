local function updateEspSystem()
    clearEsp()
    if not (boxEspEnabled or nameEspEnabled or healthEspEnabled or distanceEspEnabled or toolEspEnabled or npcEspEnabled or itemEspEnabled or highlightEspEnabled or tracersEnabled) then
        return
    end

    local activeTracerCount = 0
    local targets = {}

    for _, p in ipairs(players:GetPlayers()) do
        if p ~= player and p.Character then table.insert(targets, {model = p.Character, name = p.Name, isPlayer = true}) end
    end

    if npcEspEnabled then
        for _, m in ipairs(workspace:GetDescendants()) do
            if m:IsA("Model") and m:FindFirstChildOfClass("Humanoid") and not players:GetPlayerFromCharacter(m) and m ~= player.Character then
                table.insert(targets, {model = m, name = m.Name, isPlayer = false})
            end
        end
    end

    for _, target in ipairs(targets) do
        local model = target.model
        local hrp = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") or model:FindFirstChild("Head")
        local hum = model:FindFirstChildOfClass("Humanoid")

        if hrp and hum and hum.Health > 0 then
            local pos, onScreen = camera:WorldToViewportPoint(hrp.Position)
            if onScreen then
                if tracersEnabled then
                    activeTracerCount = activeTracerCount + 1
                    local line = tracerPool[activeTracerCount]
                    if not line then
                        line = Drawing.new("Line")
                        line.Thickness = 1.5
                        line.Color = Color3.fromRGB(0, 255, 0)
                        tracerPool[activeTracerCount] = line
                    end
                    line.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
                    line.To = Vector2.new(pos.X, pos.Y)
                    line.Visible = true
                end

                if highlightEspEnabled and not model:FindFirstChild("DaryllHighlight") then
                    local hl = Instance.new("Highlight")
                    hl.Name = "DaryllHighlight"
                    hl.FillColor = Color3.fromRGB(255, 50, 50)
                    hl.FillTransparency = 0.4
                    hl.Adornee = model
                    hl.Parent = model
                end

                if boxEspEnabled or nameEspEnabled or healthEspEnabled or distanceEspEnabled or toolEspEnabled then
                    local bgui = Instance.new("BillboardGui")
                    bgui.Name = "ESP_Tag"
                    bgui.Adornee = hrp
                    bgui.Size = UDim2.new(0, 150, 0, 70)
                    bgui.StudsOffset = Vector3.new(0, 3, 0)
                    bgui.AlwaysOnTop = true
                    bgui.Parent = espContainer

                    local textStr = ""
                    if nameEspEnabled then textStr = textStr .. target.name .. "\n" end
                    if healthEspEnabled then textStr = textStr .. "HP: " .. math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth) .. "\n" end
                    if distanceEspEnabled then
                        local dist = (camera.CFrame.Position - hrp.Position).Magnitude
                        textStr = textStr .. "[" .. math.floor(dist) .. " studs]\n"
                    end
                    if toolEspEnabled then
                        local tool = model:FindFirstChildOfClass("Tool")
                        if tool then textStr = textStr .. "Tool: " .. tool.Name .. "\n" end
                    end

                    local label = Instance.new("TextLabel")
                    label.Size = UDim2.new(1, 0, 1, 0)
                    label.BackgroundTransparency = 1
                    label.Text = textStr
                    label.TextColor3 = Color3.fromRGB(0, 255, 150)
                    label.TextSize = 10
                    label.Font = Enum.Font.GothamBold
                    label.Parent = bgui
                end
            end
        end
    end

    if itemEspEnabled then
        for _, item in ipairs(workspace:GetDescendants()) do
            if item:IsA("Tool") or (item:IsA("Handle") and item.Parent:IsA("Workspace")) then
                local part = item:IsA("Tool") and item:FindFirstChild("Handle") or item
                if part and part:IsA("BasePart") then
                    local pos, onScreen = camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local bgui = Instance.new("BillboardGui")
                        bgui.Name = "Item_ESP"
                        bgui.Adornee = part
                        bgui.Size = UDim2.new(0, 100, 0, 30)
                        bgui.AlwaysOnTop = true
                        bgui.Parent = espContainer

                        local label = Instance.new("TextLabel")
                        label.Size = UDim2.new(1, 0, 1, 0)
                        label.BackgroundTransparency = 1
                        label.Text = "[Item] " .. item.Name
                        label.TextColor3 = Color3.fromRGB(255, 220, 0)
                        label.TextSize = 10
                        label.Font = Enum.Font.GothamBold
                        label.Parent = bgui
                    end
                end
            end
        end
    end

    for i = activeTracerCount + 1, #tracerPool do tracerPool[i].Visible = false end
end

local function toggleEspMaster()
    if boxEspEnabled or nameEspEnabled or healthEspEnabled or distanceEspEnabled or toolEspEnabled or npcEspEnabled or itemEspEnabled or highlightEspEnabled or tracersEnabled then
