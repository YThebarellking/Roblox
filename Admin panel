local function createSlider(text, container, yPos, minVal, maxVal, defaultValue, step, onChanged)
    if type(step) == "function" then
        onChanged = step
        step = 1
    end
    step = step or 1

    local originalMin = minVal
    local originalMax = maxVal

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0.94, 0, 0, 40)
    frame.Position = UDim2.new(0.03, 0, 0, yPos)
    frame.BackgroundColor3 = Color3.fromRGB(27, 29, 35)
    frame.BorderSizePixel = 0
    frame.Parent = container
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 9)

    local frameStroke = Instance.new("UIStroke")
    frameStroke.Name = "ThemeStroke"
    frameStroke.Color = Color3.fromRGB(54, 57, 68)
    frameStroke.Thickness = 1
    frameStroke.Transparency = 0.15
    frameStroke.Parent = frame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.5, 0, 1, 0)
    label.Position = UDim2.new(0.03, 0, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text .. ": " .. tostring(defaultValue)
    label.TextColor3 = Color3.fromRGB(226, 228, 234)
    label.TextSize = 15
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = Enum.Font.GothamMedium
    label.Parent = frame

    local btnPlus = Instance.new("TextButton")
    btnPlus.Size = UDim2.new(0.17, 0, 0.72, 0)
    btnPlus.Position = UDim2.new(0.60, 0, 0.14, 0)
    btnPlus.BackgroundColor3 = Color3.fromRGB(40, 42, 50)
    btnPlus.Text = "+"
    btnPlus.TextColor3 = Color3.fromRGB(255, 255, 255)
    btnPlus.TextSize = 14
    btnPlus.Font = Enum.Font.GothamBold
    btnPlus.AutoButtonColor = false
    btnPlus.BorderSizePixel = 0
    btnPlus.Parent = frame
    Instance.new("UICorner", btnPlus).CornerRadius = UDim.new(0, 6)

    local btnMinus = Instance.new("TextButton")
    btnMinus.Size = UDim2.new(0.17, 0, 0.72, 0)
    btnMinus.Position = UDim2.new(0.80, 0, 0.14, 0)
    btnMinus.BackgroundColor3 = Color3.fromRGB(40, 42, 50)
    btnMinus.Text = "-"
    btnMinus.TextColor3 = Color3.fromRGB(255, 255, 255)
    btnMinus.TextSize = 14
    btnMinus.Font = Enum.Font.GothamBold
    btnMinus.AutoButtonColor = false
    btnMinus.BorderSizePixel = 0
    btnMinus.Parent = frame
    Instance.new("UICorner", btnMinus).CornerRadius = UDim.new(0, 6)

    btnPlus.MouseEnter:Connect(function() btnPlus.BackgroundColor3 = Color3.fromRGB(52, 55, 66) end)
    btnPlus.MouseLeave:Connect(function() btnPlus.BackgroundColor3 = Color3.fromRGB(40, 42, 50) end)
    btnMinus.MouseEnter:Connect(function() btnMinus.BackgroundColor3 = Color3.fromRGB(52, 55, 66) end)
    btnMinus.MouseLeave:Connect(function() btnMinus.BackgroundColor3 = Color3.fromRGB(40, 42, 50) end)

    local slider = {
        Text = text,
        Frame = frame,
        Label = label,
        Plus = btnPlus,
        Minus = btnMinus,
        Minimum = originalMin,
        Maximum = originalMax,
        NormalMinimum = originalMin,
        NormalMaximum = originalMax,
        Step = step,
        Value = defaultValue,
        Callback = onChanged,
    }

    table.insert(H.sliders, slider)

    local function formatValue(value)
        if step < 1 then
            return string.format("%.1f", value)
        end
        if value >= 1000 then
            return string.format("%.0f", value)
        end
        return tostring(math.floor(value + 0.5))
    end

    local function refreshLabel()
        label.Text = text .. ": " .. formatValue(slider.Value)
    end

    local function updateValue(newVal, runCallback)
        local minLimit = H.noFunctionLimits and 0 or slider.NormalMinimum
        local maxLimit = H.noFunctionLimits and 1000000 or slider.NormalMaximum

        newVal = math.clamp(newVal, minLimit, maxLimit)

        if step < 1 then
            newVal = math.floor(newVal / step + 0.5) * step
            newVal = math.floor(newVal * 10 + 0.5) / 10
        else
            newVal = math.floor(newVal / step + 0.5) * step
        end

        newVal = math.clamp(newVal, minLimit, maxLimit)
        slider.Minimum = minLimit
        slider.Maximum = maxLimit
        slider.Value = newVal
        refreshLabel()

        if runCallback ~= false and onChanged then
            onChanged(newVal)
        end
    end

    slider.SetValue = function(value)
        updateValue(value, true)
    end

    btnPlus.MouseButton1Click:Connect(function()
        updateValue(slider.Value + step)
    end)

    btnMinus.MouseButton1Click:Connect(function()
        updateValue(slider.Value - step)
    end)

    updateValue(defaultValue, true)
    return frame
end

local function updateAllSliderLimits()
    for _, slider in ipairs(H.sliders) do
        local minLimit = H.noFunctionLimits and 0 or slider.NormalMinimum
        local maxLimit = H.noFunctionLimits and 1000000 or slider.NormalMaximum

        slider.Minimum = minLimit
        slider.Maximum = maxLimit

        if slider.Value < minLimit then
            slider.Value = minLimit
            slider.Callback(slider.Value)
        elseif slider.Value > maxLimit then
            slider.Value = maxLimit
            slider.Callback(slider.Value)
        end

        local value = slider.Value
        if slider.Step < 1 then
            slider.Label.Text = slider.Text .. ": " .. string.format("%.1f", value)
        elseif value >= 1000 then
            slider.Label.Text = slider.Text .. ": " .. string.format("%.0f", value)
        else
            slider.Label.Text = slider.Text .. ": " .. tostring(math.floor(value + 0.5))
        end
    end
end

