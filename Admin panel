local flyBtn = createToggleButton("Fly", playerContainer, yOffset)
yOffset = yOffset + 42
local bg, bv

flyBtn.MouseButton1Click:Connect(function()
    flyEnabled = not flyEnabled
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")
    
    if flyEnabled and hrp and hum then
        flyBtn.Text = "Fly [ON]"
        flyBtn.TextColor3 = Color3.fromRGB(50, 200, 50)
        
        bg = Instance.new("BodyGyro")
        bg.P = 9e4
        bg.maxTorque = Vector3.new(9e9, 9e9, 9e9)
        bg.cframe = hrp.CFrame
        bg.Parent = hrp
        
        bv = Instance.new("BodyVelocity")
        bv.velocity = Vector3.new(0, 0, 0)
        bv.maxForce = Vector3.new(9e9, 9e9, 9e9)
        bv.Parent = hrp
        
        hum.PlatformStand = true
        
        flyInputBegan = userInputService.InputBegan:Connect(function(input, gpe)
            if gpe then return end
            if input.KeyCode == Enum.KeyCode.W then flyKeys.W = true end
            if input.KeyCode == Enum.KeyCode.S then flyKeys.S = true end
            if input.KeyCode == Enum.KeyCode.A then flyKeys.A = true end
            if input.KeyCode == Enum.KeyCode.D then flyKeys.D = true end
            if input.KeyCode == Enum.KeyCode.Space then flyKeys.Space = true end
            if input.KeyCode == Enum.KeyCode.LeftShift then flyKeys.LeftShift = true end
        end)

        flyInputEnded = userInputService.InputEnded:Connect(function(input)
            if input.KeyCode == Enum.KeyCode.W then flyKeys.W = false end
            if input.KeyCode == Enum.KeyCode.S then flyKeys.S = false end
            if input.KeyCode == Enum.KeyCode.A then flyKeys.A = false end
            if input.KeyCode == Enum.KeyCode.D then flyKeys.D = false end
            if input.KeyCode == Enum.KeyCode.Space then flyKeys.Space = false end
            if input.KeyCode == Enum.KeyCode.LeftShift then flyKeys.LeftShift = false end
        end)
        
        task.spawn(function()
            while flyEnabled and char and hum and hum.Parent do
                runService.RenderStepped:Wait()
                local moveDir = Vector3.new(
                    (flyKeys.D and 1 or 0) - (flyKeys.A and 1 or 0),
                    (flyKeys.Space and 1 or 0) - (flyKeys.LeftShift and 1 or 0),
                    (flyKeys.S and 1 or 0) - (flyKeys.W and 1 or 0)
                )
                local camCF = camera.CFrame
                local moveVector = (camCF.RightVector * moveDir.X) + (camCF.LookVector * -moveDir.Z) + (Vector3.new(0, 1, 0) * moveDir.Y)
                
                bv.velocity = moveVector * (flySpeed * 50)
                bg.cframe = camCF
            end
        end)
    else
        flyBtn.Text = "Fly [OFF]"
        flyBtn.TextColor3 = Color3.fromRGB(200, 50, 50)
        if bg then bg:Destroy() bg = nil end
        if bv then bv:Destroy() bv = nil end
        if flyInputBegan then flyInputBegan:Disconnect() flyInputBegan = nil end
        if flyInputEnded then flyInputEnded:Disconnect() flyInputEnded = nil end
        if hum then hum.PlatformStand = false end
    end
end)

