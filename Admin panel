local function createSettingToggle(text, parent, yPos, initialValue, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 28)
    btn.Position = UDim2.new(0.05, 0, 0, yPos)
    btn.BackgroundColor3 = themePalettes.Black.btnBg
    btn.Text = text .. (initialValue and " [ON]" or " [OFF]")
    btn.TextColor3 = initialValue and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(239, 68, 68)
    btn.TextSize = 11
    btn.Font = Enum.Font.GothamBold
    btn.ZIndex = 9
    btn.Parent = parent
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = themePalettes.Black.border
    stroke.Thickness = 1
    stroke.Parent = btn
    table.insert(themeRegistry.strokes, stroke)
    table.insert(themeRegistry.toggleButtons, {button = btn})

    local state = initialValue
    trackConnection(btn.MouseButton1Click:Connect(function()
        state = not state
        btn.Text = text .. (state and " [ON]" or " [OFF]")
        btn.TextColor3 = state and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(239, 68, 68)
        callback(state)
    end))
    return btn
end

