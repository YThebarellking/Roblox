-- Invisible
local function setCharacterTransparency(character, transparency)
    if not character then return end
    for _, descendant in ipairs(character:GetDescendants()) do
        if descendant:IsA("BasePart") or descendant:IsA("Decal") then
            descendant.Transparency = transparency
        end
    end
end

local function applyInvisibility(character, enabled)
    if not character then return end
    if enabled then
        if invisChair then invisChair:Destroy() end
        if invisConnection then invisConnection:Disconnect() end
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local savedPosition = hrp.CFrame
        character:MoveTo(INVISIBILITY_POSITION)
        task.wait(0.15)
        local seat = Instance.new("Seat")
        seat.Name = "invischair"
        seat.Anchored = false
        seat.CanCollide = false
        seat.Transparency = 1
        seat.Position = INVISIBILITY_POSITION
        seat.Parent = workspace
        local weld = Instance.new("Weld")
        weld.Part0 = seat
        weld.Part1 = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
        weld.Parent = seat
        task.wait()
        seat.CFrame = savedPosition
        setCharacterTransparency(character, 1)
        invisChair = seat
        invisConnection = character.ChildAdded:Connect(function(child)
            task.wait()
            if child:IsA("Tool") or child:IsA("BasePart") then setCharacterTransparency(child, 0) end
        end)
    else
        if invisChair then invisChair:Destroy() invisChair = nil end
        if invisConnection then invisConnection:Disconnect() invisConnection = nil end
        setCharacterTransparency(character, 0)
    end
end

