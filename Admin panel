local function executeFlingOnTarget(target)
    if not target or not target.Character then return end
    if ignoreFriendsFling and player:IsFriendsWith(target.UserId) then return end
    
    local myHrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local targetHrp = target.Character:FindFirstChild("HumanoidRootPart")
    if not myHrp or not targetHrp then return end

    local originalCF = myHrp.CFrame
    local startTime = tick()

    while target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") and (tick() - startTime < flingTimeoutVal) do
        runService.Heartbeat:Wait()
        tHrp = target.Character:FindFirstChild("HumanoidRootPart")
        if not tHrp then break end
        
        myHrp.CFrame = tHrp.CFrame * CFrame.new(math.random(-1, 1), 0, math.random(-1, 1))
        myHrp.AssemblyAngularVelocity = Vector3.new(0, flingStrengthVal, 0)
        myHrp.AssemblyLinearVelocity = Vector3.new(flingSpeedVal, 10000, flingSpeedVal)
    end

    myHrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    myHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    myHrp.CFrame = originalCF
end

