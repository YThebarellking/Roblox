    H.equipCheatEnabled = not H.equipCheatEnabled
    H.setToggleState(H.equipCheatBtn, "Equip Cheat", H.equipCheatEnabled)

    disconnectEquipCheat()
    if H.equipCheatEnabled then
        bindEquipCheat(player.Character)
    end
end)

