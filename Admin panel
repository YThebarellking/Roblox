local function serverHopLogic()
    local httpReq = (syn and syn.request) or (http and http.request) or http_request or request
    if httpReq then
        local serversUrl = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
        local rawData = httpReq({Url = serversUrl, Method = "GET"})
        local data = httpService:JSONDecode(rawData.Body)
        if data and data.data then
            for _, s in ipairs(data.data) do
                if s.playing < s.maxPlayers and s.id ~= game.JobId then
                    teleportService:TeleportToPlaceInstance(game.PlaceId, s.id, player)
                    return
                end
            end
        end
    end
end

