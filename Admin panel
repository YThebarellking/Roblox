-- SLIDER SYSTEM
--==================================================

local Sliders = {}

local UnlockMaximums = {
    ["Walk Speed"] = 10000,
    ["Jump Power"] = 10000,
    ["Gravity"] = 5000,
    ["Hip Height"] = 1000,

    ["Fly Speed"] = 1000,
    ["Camera Distance"] = 1000,

    ["Camera FOV"] = 180,
    ["Time of Day"] = 24,

    ["Light Range"] = 1000,
    ["Light Strength"] = 1000,

    ["TP Delay"] = 600,
}

local function createSlider(
    text,
    parent,
    y,
    minimum,
    maximum,
    defaultValue,
    step,
    callback
)
    local frame = Instance.new("Frame")

    frame.Size = UDim2.new(0.92, 0, 0, 38)
    frame.Position = UDim2.new(0.04, 0, 0, y)

    frame.BorderSizePixel = 0
    frame.Parent = parent
    setRole(frame, "Button")

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = frame

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1
    stroke.Parent = frame
    setRole(stroke, "Stroke")

    local label = Instance.new("TextLabel")

    label.Size = UDim2.new(0.52, 0, 1, 0)
    label.Position = UDim2.new(0.03, 0, 0, 0)

    label.BackgroundTransparency = 1
    label.TextSize = 11
    label.TextXAlignment =
        Enum.TextXAlignment.Left

    label.Font = Enum.Font.GothamMedium
    label.Parent = frame
    setRole(label, "Text")

    local minus = Instance.new("TextButton")

    minus.Size = UDim2.new(0.18, 0, 0.7, 0)
    minus.Position = UDim2.new(0.60, 0, 0.15, 0)

    minus.BorderSizePixel = 0
    minus.Text = "-"
    minus.TextSize = 14
    minus.Font = Enum.Font.GothamBold

    minus.Parent = frame
    setRole(minus, "SecondaryButton")

    Instance.new("UICorner", minus).CornerRadius = UDim.new(0, 4)

    local plus = Instance.new("TextButton")

    plus.Size = UDim2.new(0.18, 0, 0.7, 0)
    plus.Position = UDim2.new(0.80, 0, 0.15, 0)

    plus.BorderSizePixel = 0
    plus.Text = "+"
    plus.TextSize = 14
    plus.Font = Enum.Font.GothamBold

    plus.Parent = frame
    setRole(plus, "SecondaryButton")

    Instance.new("UICorner", plus).CornerRadius = UDim.new(0, 4)

    local slider = {
        Text = text,
        Minimum = minimum,
        NormalMaximum = maximum,

        Maximum =
            State.Settings.NoLimits
            and (UnlockMaximums[text] or maximum * 100)
            or maximum,

        Step = step,
        Value = defaultValue,

        Frame = frame,
        Label = label,

        Callback = callback,
    }

    local function formatValue(value)
        if step < 1 then
            return string.format("%.1f", value)
        end

        if value >= 1000 then
            return string.format("%.0f", value)
        end

        return tostring(math.floor(value + 0.5))
    end

    local function refreshLabel()
        label.Text =
            text .. ": " ..
            formatValue(slider.Value)
    end

    local function setValue(value, runCallback)
        value = math.clamp(
            value,
            slider.Minimum,
            slider.Maximum
        )

        if step < 1 then
            value =
                math.floor(
                    value / step + 0.5
                ) * step

            value =
                math.floor(
                    value * 10 + 0.5
                ) / 10
        else
            value =
                math.floor(
                    value / step + 0.5
                ) * step
        end

        value = math.clamp(
            value,
            slider.Minimum,
            slider.Maximum
        )

        slider.Value = value

        refreshLabel()

        if runCallback and slider.Callback then
            slider.Callback(value)
        end
    end

    function slider:SetLimitsEnabled(enabled)
        if enabled then
            slider.Maximum =
                UnlockMaximums[text]
                or maximum * 100
        else
            slider.Maximum = slider.NormalMaximum
        end

        if slider.Value > slider.Maximum then
            setValue(slider.Maximum, true)
        else
            refreshLabel()
        end
    end

    function slider:SetValue(value)
        setValue(value, true)
    end

    plus.MouseButton1Click:Connect(function()
        setValue(
            slider.Value + slider.Step,
            true
        )
    end)

    minus.MouseButton1Click:Connect(function()
        setValue(
            slider.Value - slider.Step,
            true
        )
    end)

    setValue(defaultValue, true)

    table.insert(Sliders, slider)

    return slider
end

local function updateAllSliderLimits()
    for _, slider in ipairs(Sliders) do
        slider:SetLimitsEnabled(
            State.Settings.NoLimits
        )
    end
end

