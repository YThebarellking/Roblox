local function getChatChannel(destination)
    if not textChatService then return nil end
    local channels = textChatService:FindFirstChild("TextChannels")
    if not channels then return nil end

    local wanted = {}
    if destination == "Here" then
        wanted = {"Here", "Local", "Nearby", "RBXTeam", "RBXGeneral"}
    elseif destination == "Global" then
        wanted = {"Global", "RBXGeneral"}
    else
        wanted = {"All", "Global", "RBXGeneral"}
    end

    for _, name in ipairs(wanted) do
        local channel = channels:FindFirstChild(name)
        if channel and channel:IsA("TextChannel") then
            return channel
        end
    end

    for _, channel in ipairs(channels:GetChildren()) do
        if channel:IsA("TextChannel") then
            local n = string.lower(channel.Name)
            if destination == "Here"
                and (n:find("here", 1, true) or n:find("local", 1, true) or n:find("near", 1, true)) then
                return channel
            elseif destination == "Global" and n:find("global", 1, true) then
                return channel
            elseif destination == "All" and n:find("all", 1, true) then
                return channel
            end
        end
    end

    return channels:FindFirstChild("RBXGeneral")
end

local function sendChatMessage(message, destination)
    message = tostring(message or "")
    if message:gsub("%s+", "") == "" then return false end

    local channel = getChatChannel(destination)
    if channel then
        local ok = pcall(function()
            channel:SendAsync(message)
        end)
        if ok then return true end
    end

    if not replicatedStorage then return false end
    local chatEvents = replicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
    local sayMessageRequest = chatEvents and chatEvents:FindFirstChild("SayMessageRequest")
    if sayMessageRequest and sayMessageRequest:IsA("RemoteEvent") then
        local ok = pcall(function()
            sayMessageRequest:FireServer(message, "All")
        end)
        if ok then return true end
    end

    return false
end

