local function restoreLowGraphics()
    for obj, data in pairs(H.lowGraphicsBackup) do
        if obj and obj.Parent then
            if data.Material ~= nil then pcall(function() obj.Material = data.Material end) end
            if data.CastShadow ~= nil then pcall(function() obj.CastShadow = data.CastShadow end) end
            if data.Enabled ~= nil then pcall(function() obj.Enabled = data.Enabled end) end
            if data.Reflectance ~= nil then pcall(function() obj.Reflectance = data.Reflectance end) end
        end
    end
    table.clear(H.lowGraphicsBackup)
end

local function enableLowGraphics()
    restoreLowGraphics()

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            H.lowGraphicsBackup[obj] = {
                Material = obj.Material,
                CastShadow = obj.CastShadow,
                Reflectance = obj.Reflectance,
            }

            pcall(function() obj.Material = Enum.Material.SmoothPlastic end)
            pcall(function() obj.CastShadow = false end)
            pcall(function() obj.Reflectance = 0 end)

        elseif obj:IsA("ParticleEmitter")
            or obj:IsA("Trail")
            or obj:IsA("Beam")
            or obj:IsA("Smoke")
            or obj:IsA("Fire")
            or obj:IsA("Sparkles") then

            H.lowGraphicsBackup[obj] = {
                Enabled = obj.Enabled,
            }

            pcall(function() obj.Enabled = false end)
        end
    end
end

