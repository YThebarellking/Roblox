local function createSlider(text, parent, y, minValue, maxValue, defaultValue, step, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0.92, 0, 0, 38)
    frame.Position = UDim2.new(0.04, 0, 0, y)
    frame.BackgroundColor3 = Color3.fromRGB(28, 28, 30)
    frame.BorderSizePixel = 0
    frame.Parent = parent

    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(45, 45, 48)
    stroke.Parent = frame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.52, 0, 1, 0)
    label.Position = UDim2.new(0.03, 0, 0, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(230, 230, 230)
    label.TextSize = 11
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = Enum.Font.GothamMedium
    label.Parent = frame

    local minus = Instance.new("TextButton")
    minus.Size = UDim2.new(0.18, 0, 0.7, 0)
    minus.Position = UDim2.new(0.60, 0, 0.15, 0)
    minus.BackgroundColor3 = Color3.fromRGB(40, 40, 44)
    minus.Text = "-"
    minus.TextColor3 = Color3.fromRGB(255, 255, 255)
    minus.TextSize = 14
    minus.Font = Enum.Font.GothamBold
    minus.Parent = frame

    Instance.new("UICorner", minus).CornerRadius = UDim.new(0, 4)

    local plus = Instance.new("TextButton")
    plus.Size = UDim2.new(0.18, 0, 0.7, 0)
    plus.Position = UDim2.new(0.80, 0, 0.15, 0)
    plus.BackgroundColor3 = Color3.fromRGB(40, 40, 44)
    plus.Text = "+"
    plus.TextColor3 = Color3.fromRGB(255, 255, 255)
    plus.TextSize = 14
    plus.Font = Enum.Font.GothamBold
    plus.Parent = frame

    Instance.new("UICorner", plus).CornerRadius = UDim.new(0, 4)

    local value = defaultValue

    local function update(newValue)
        newValue = math.clamp(newValue, minValue, maxValue)

        local decimals = step < 1 and 2 or 0
        local multiplier = 10 ^ decimals

        newValue = math.round(newValue * multiplier) / multiplier

        value = newValue
        label.Text = text .. ": " .. tostring(newValue)

        if callback then
            callback(newValue)
        end
    end

    plus.MouseButton1Click:Connect(function()
        update(value + step)
    end)

    minus.MouseButton1Click:Connect(function()
        update(value - step)
    end)

    update(defaultValue)

    return {
        Frame = frame,
        Label = label,
        GetValue = function()
            return value
        end,
        SetValue = update,
    }
end

