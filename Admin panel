local FPSBoostButton = createToggle(
    "FPS Booster",
    UtilityContainer,
    y
)

y += 46

local FPSOriginal = {}
local FPSDescendantConnection

local function saveFPSValue(instance, property)
    FPSOriginal[instance] = FPSOriginal[instance] or {}

    if FPSOriginal[instance][property] == nil then
        local success, value = pcall(function()
            return instance[property]
        end)

        if success then
            FPSOriginal[instance][property] = value
        end
    end
end

local function optimizeInstance(instance)
    if instance:IsA("BasePart") then
        saveFPSValue(instance, "Material")
        instance.Material = Enum.Material.SmoothPlastic

    elseif instance:IsA("ParticleEmitter")
        or instance:IsA("Trail")
        or instance:IsA("Beam")
        or instance:IsA("Smoke")
        or instance:IsA("Fire")
        or instance:IsA("Sparkles") then

        saveFPSValue(instance, "Enabled")

        pcall(function()
            instance.Enabled = false
        end)
    end
end

local function restoreFPS()
    for instance, properties in pairs(FPSOriginal) do
        if instance and instance.Parent then
            for property, value in pairs(properties) do
                pcall(function()
                    instance[property] = value
                end)
            end
        end
    end

    table.clear(FPSOriginal)
end

local function enableFPSBoost()
    for _, instance in ipairs(workspace:GetDescendants()) do
        optimizeInstance(instance)
    end

    FPSDescendantConnection = workspace.DescendantAdded:Connect(function(instance)
        if State.Utility.FPSBoosted then
            task.defer(function()
                optimizeInstance(instance)
            end)
        end
    end)
end

local function disableFPSBoost()
    if FPSDescendantConnection then
        FPSDescendantConnection:Disconnect()
        FPSDescendantConnection = nil
    end

    restoreFPS()
end

FPSBoostButton.MouseButton1Click:Connect(function()
    State.Utility.FPSBoosted =
        not State.Utility.FPSBoosted

    setButtonState(
        FPSBoostButton,
        "FPS Booster",
        State.Utility.FPSBoosted
    )

    if State.Utility.FPSBoosted then
        enableFPSBoost()
    else
        disableFPSBoost()
    end
end)

