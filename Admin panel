local cleanedUp = false

ScreenGui.Destroying:Connect(function()

    if cleanedUp then
        return
    end

    cleanedUp = true

    disconnectAll()

    if InvisibleConnection then
        InvisibleConnection:Disconnect()
        InvisibleConnection = nil
    end

    if FPSAddedConnection then
        FPSAddedConnection:Disconnect()
        FPSAddedConnection = nil
    end

    if autoTeleportThread then
        task.cancel(autoTeleportThread)
        autoTeleportThread = nil
    end

    clearXRay()

    disableNoclip()
    disableFly()
    disableAirWalk()
    disableCameraNoclip()
    applyFreezeCharacter(false)

    if State.Utility.FPSBoosted then
        disableFPSBoost()
    end

    -- Восстанавливаем состояния для Anti
