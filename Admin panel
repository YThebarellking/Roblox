local InvisibleConnection

local function setCharacterTransparency(character, transparency)
    for _, obj in ipairs(character:GetDescendants()) do
        if obj:IsA("BasePart")
            or obj:IsA("Decal")
            or obj:IsA("Texture") then

            obj.LocalTransparencyModifier = transparency
        end
    end
end

local function setInvisible(enabled)
    local character = getCharacter()

    if InvisibleConnection then
        InvisibleConnection:Disconnect()
        InvisibleConnection = nil
    end

    if not character then
        return
    end

    if enabled then
        setCharacterTransparency(character, 1)

        InvisibleConnection =
            character.DescendantAdded:Connect(function(obj)
                if obj:IsA("BasePart")
                    or obj:IsA("Decal")
                    or obj:IsA("Texture") then

                    obj.LocalTransparencyModifier = 1
                end
            end)
    else
        setCharacterTransparency(character, 0)
    end
end

