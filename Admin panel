local FallDamageOriginal = {}

local function applyAntiFallDamage()
    if not State.Anti.AntiFallDamage then
        return
    end

    local humanoid = getHumanoid()
    local root = getRoot()

    if not humanoid or not root then
        return
    end

    local velocity = root.AssemblyLinearVelocity
    
    -- Проверяем, находится ли персонаж в состоянии падения
    local state = humanoid:GetState()
    local isFalling = state == Enum.HumanoidStateType.FallingDown or 
                     state == Enum.HumanoidStateType.Ragdoll
    
    if isFalling then
        -- Сохраняем здоровье перед падением
        if FallDamageOriginal[humanoid] == nil then
            FallDamageOriginal[humanoid] = humanoid.Health
        end
    else
        -- При приземлении проверяем, был ли урон от падения
        local savedHealth = FallDamageOriginal[humanoid]
        if savedHealth and humanoid.Health < savedHealth then
            -- Восстанавливаем только если разница не слишком большая (урон от падения обычно не более 50-100)
            local damage = savedHealth - humanoid.Health
            if damage <= 100 and damage > 0 then
                humanoid.Health = savedHealth
            end
        end
        FallDamageOriginal[humanoid] = nil
    end
end

