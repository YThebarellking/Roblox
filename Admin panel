-- FPS Booster

local FPSBoostButton = createToggle(
    "FPS Booster",
    UtilityContainer,
    y
)

y = y + 46

local FPSOriginal = {}
local FPSAddedConnection = nil

local function saveProperty(
    object,
    property
)
    if not FPSOriginal[object] then
        FPSOriginal[object] = {}
    end

    if FPSOriginal[object][property] ~= nil then
        return
    end

    local success, value =
        pcall(function()
            return object[property]
        end)

    if success then
        FPSOriginal[object][property] =
            value
    end
end

local function optimizeObject(object)
    if object:IsA("BasePart") then
        saveProperty(
            object,
            "Material"
        )

        object.Material =
            Enum.Material.SmoothPlastic

    elseif object:IsA("ParticleEmitter")
        or object:IsA("Trail")
        or object:IsA("Beam")
        or object:IsA("Smoke")
        or object:IsA("Fire")
        or object:IsA("Sparkles") then

        saveProperty(
            object,
            "Enabled"
        )

        pcall(function()
            object.Enabled = false
        end)
    end
end

local function enableFPSBoost()
    for _, object in ipairs(
        workspace:GetDescendants()
    ) do
        optimizeObject(object)
    end

    if FPSAddedConnection then
        FPSAddedConnection:Disconnect()
    end

    FPSAddedConnection =
        workspace.DescendantAdded:Connect(
            function(object)
                if not State.Utility.FPSBoosted then
                    return
                end

                task.defer(function()
                    if object and object.Parent then
                        optimizeObject(object)
                    end
                end)
            end
        )
end

local function disableFPSBoost()
    if FPSAddedConnection then
        FPSAddedConnection:Disconnect()
        FPSAddedConnection = nil
    end

    for object, properties in pairs(
        FPSOriginal
    ) do
        if object and object.Parent then
            for property, value in pairs(
                properties
            ) do
                pcall(function()
                    object[property] = value
                end)
            end
        end
    end

    table.clear(FPSOriginal)
end

FPSBoostButton.MouseButton1Click:Connect(function()
    State.Utility.FPSBoosted =
        not State.Utility.FPSBoosted

    setToggleVisual(
        FPSBoostButton,
        "FPS Booster",
        State.Utility.FPSBoosted
    )

    if State.Utility.FPSBoosted then
        enableFPSBoost()
    else
        disableFPSBoost()
    end
end)

--==================================================
-- CHARACTER HANDLING
--==================================================

local function applyCharacterSettings(character)
    local humanoid =
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not humanoid then
        return
    end

    humanoid.UseJumpPower = true

    humanoid.WalkSpeed =
        State.Player.WalkSpeed

    humanoid.JumpPower =
        State.Player.JumpPower

    humanoid.HipHeight =
        State.Player.HipHeight

    if State.Player.GodMode then
        humanoid:SetStateEnabled(
            Enum.HumanoidStateType.Dead,
            false
        )
    end
end

LocalPlayer.CharacterAdded:Connect(function(character)
    task.wait(0.25)

    local humanoid =
        character:WaitForChild(
            "Humanoid",
            5
        )

    if not humanoid then
        return
    end

    captureCharacterDefaults(character)

    applyCharacterSettings(character)

    if State.Movement.Noclip then
        disableNoclip()
        enableNoclip()
    end

    if State.Movement.Fly then
        disableFly()
        enableFly()
    end

    if State.Player.Invisible then
        task.wait(0.1)
        setInvisible(true)
    end

    if State.Visual.Light then
        task.wait(0.1)
        updateLight()
    end

    if State.Player.GodMode then
        task.wait(0.1)
        applyGodMode()
    end
end)

--==================================================
-- CAMERA / RESPAWN SAFETY
--==================================================

workspace:GetPropertyChangedSignal(
    "CurrentCamera"
):Connect(function()
    local newCamera =
        workspace.CurrentCamera

    if newCamera then
        Camera = newCamera

        if State.Visual.FOV then
            Camera.FieldOfView =
                State.Visual.FOV
        end

        if State.Players.Spectating then
            local target =
                State.Players.Selected

            if target
                and target.Character then

                local humanoid =
                    target.Character:FindFirstChildOfClass(
                        "Humanoid"
                    )

                if humanoid then
                    Camera.CameraSubject =
                        humanoid
                end
            end
        end
    end
end)

