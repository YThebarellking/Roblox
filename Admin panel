local function applyTheme(themeName)
    currentTheme = themeName
    local colors = themePalettes[themeName] or themePalettes.Black

    for _, frame in ipairs(themeRegistry.mainFrame) do frame.BackgroundColor3 = colors.mainBg end
    for _, frame in ipairs(themeRegistry.tabPanel) do frame.BackgroundColor3 = colors.tabBg end
    for _, header in ipairs(themeRegistry.headers) do header.BackgroundColor3 = colors.headerBg end
    for _, stroke in ipairs(themeRegistry.strokes) do stroke.Color = colors.border end
    for _, btn in ipairs(themeRegistry.buttons) do btn.BackgroundColor3 = colors.btnBg end
    
    for _, item in ipairs(themeRegistry.tabButtons) do
        if item.isActive then
            item.button.BackgroundColor3 = colors.activeTabBg
            item.button.TextColor3 = colors.text
        else
            item.button.BackgroundColor3 = colors.tabBg
            item.button.TextColor3 = colors.subText
        end
    end

    for _, item in ipairs(themeRegistry.toggleButtons) do
        item.button.BackgroundColor3 = colors.btnBg
    end
end

