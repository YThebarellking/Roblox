--==================================================
-- CHARACTER EVENTS
--==================================================

local function applyCharacterSettings(character)
    local humanoid =
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not humanoid then
        return
    end

    humanoid.UseJumpPower = true

    humanoid.WalkSpeed =
        State.Player.WalkSpeed

    humanoid.JumpPower =
        State.Player.JumpPower

    humanoid.HipHeight =
        State.Player.HipHeight

    if State.Player.GodMode then
        humanoid:SetStateEnabled(
            Enum.HumanoidStateType.Dead,
            false
        )
    end
end

LocalPlayer.CharacterAdded:Connect(function(character)

    task.wait(0.25)

    local humanoid =
        character:WaitForChild(
            "Humanoid",
            5
        )

    if not humanoid then
        return
    end

    captureCharacterDefaults(
        character
    )

    applyCharacterSettings(
        character
    )

    if State.Movement.Noclip then
        disableNoclip()
        enableNoclip()
    end

    if State.Movement.Fly then
        disableFly()
        enableFly()
    end

    if State.Player.Invisible then
        task.wait(0.1)
        setInvisible(true)
    end

    if State.Visual.Light then
        task.wait(0.1)
        updateLight()
    end

    if State.Player.GodMode then
        task.wait(0.1)
        applyGodMode()
    end

    if State.Player.FreezeCharacter then
        task.wait(0.1)
        applyFreezeCharacter(true)
    end

    if State.Movement.AirWalk then
        task.wait(0.1)
        enableAirWalk()
    end

    if State.Anti.AntiJumpDisable then
        task.wait(0.1)
        applyAntiJumpDisable()
    end

    if State.Anti.AntiSeat then
        task.wait(0.1)
        applyAntiSeat()
    end

    if State.Anti.AntiFling then
        task.wait(0.1)
        -- AntiFling работает через heartbeat, ничего дополнительно не нужно
    end

    if State.Anti.AntiFallDamage then
        task.wait(0.1)
        -- AntiFallDamage работает через heartbeat, ничего дополнительно не нужно
    end

    if State.Players.Spectating then
        local target =
            State.Players.Selected

        if target
            and target.Character then

            local targetHumanoid =
                target.Character:FindFirstChildOfClass(
                    "Humanoid"
                )

            if targetHumanoid then
                Camera.CameraSubject =
                    targetHumanoid
            end
        end
    end
end)

workspace:GetPropertyChangedSignal(
    "CurrentCamera"
):Connect(function()

    local newCamera =
        workspace.CurrentCamera

    if not newCamera then
        return
    end

    Camera = newCamera

    Camera.FieldOfView =
        State.Visual.FOV

    if State.Players.Spectating then

        local target =
            State.Players.Selected

        if target
            and target.Character then

            local humanoid =
                target.Character:FindFirstChildOfClass(
                    "Humanoid"
                )

            if humanoid then
                Camera.CameraSubject =
                    humanoid
            end
        end
    end
end)

