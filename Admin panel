        H.antiVelocityLoop:Disconnect()
        H.antiVelocityLoop = nil
    end

    if H.antiVelocityEnabled then
        H.antiVelocityLoop = runService.Heartbeat:Connect(function()
            if not H.antiVelocityEnabled or H.flyEnabled or H.isClientTeleportAllowed() or H.autoTeleportEnabled or H.touchFlingActive then return end

            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if not hum or not root then return end

            local velocity = root.AssemblyLinearVelocity
            local maxHorizontal = math.max(90, H.walkSpeed * 4)
            local maxVertical = math.max(100, H.jumpPower * 2.5)
            local horizontal = Vector3.new(velocity.X, 0, velocity.Z)

            if horizontal.Magnitude > maxHorizontal then
                local moveDir = hum.MoveDirection
                local replacement = moveDir.Magnitude > 0.05 and moveDir.Unit * H.walkSpeed or Vector3.zero
                root.AssemblyLinearVelocity = Vector3.new(
                    replacement.X,
                    math.clamp(velocity.Y, -maxVertical, maxVertical),
                    replacement.Z
                )
            elseif math.abs(velocity.Y) > maxVertical then
                root.AssemblyLinearVelocity = Vector3.new(velocity.X, 0, velocity.Z)
            end

            if root.AssemblyAngularVelocity.Magnitude > 60 then
                root.AssemblyAngularVelocity = Vector3.zero
            end
        end)
        trackConnection(H.antiVelocityLoop)
    end
