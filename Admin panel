-- Clean script unload function
local function unloadScript()
    -- Reset states
    godModeEnabled = false
    noclipEnabled = false
    antiFlingEnabled = false
    xrayEnabled = false
    flyEnabled = false
    infiniteJumpEnabled = false
    cameraNoclipEnabled = false
    invisibleEnabled = false
    clickTpEnabled = false
    autoBhopEnabled = false
    spinbotEnabled = false
    tracersEnabled = false
    antiAfkEnabled = false
    lookAtTargetEnabled = false
    spectatingPlayer = nil

    if player.Character and player.Character:FindFirstChild("Humanoid") then
        camera.CameraSubject = player.Character.Humanoid
        player.Character.Humanoid.WalkSpeed = 16
        player.Character.Humanoid.JumpPower = 50
        player.Character.Humanoid.HipHeight = 2
        player.Character.Humanoid.UseJumpPower = true
    end

    workspace.Gravity = 196.2
    camera.FieldOfView = 70
    player.CameraMinZoomDistance = 0.5
    player.CameraMaxZoomDistance = 400

    if invisChair then invisChair:Destroy() invisChair = nil end

    for _, conn in ipairs(scriptConnections) do
        if conn then conn:Disconnect() end
    end
    scriptConnections = {}

    for _, loop in ipairs(activeLoops) do
        if loop then loop:Disconnect() end
    end
    activeLoops = {}

    screenGui:Destroy()
end

