H.characterAddedConnection = player.CharacterAdded:Connect(function(newCharacter)
    if H.closed then return end
    task.wait(0.2)
    local humanoid = newCharacter:WaitForChild("Humanoid", 5)
    if humanoid then
        humanoid.UseJumpPower = true
        humanoid.WalkSpeed = walkSpeed
        humanoid.JumpPower = jumpPower
        humanoid.HipHeight = hipHeightVal
    end
    if godModeEnabled then setupGodMode(newCharacter) end
    if flyEnabled then
        local hum = newCharacter:FindFirstChild("Humanoid")
        if hum then hum.PlatformStand = true end
    end
    if invisibleEnabled then applyInvisibility(newCharacter, true) end
    if lightEnabled then updateLight() end
    if H.airWalkEnabled then
        task.wait(0.1)
        enableAirWalk()
    end
    if H.freezeCharacterEnabled then
        task.wait(0.1)
        setFreezeCharacter(true)
    end
    if spectatingPlayer then camera.CameraSubject = spectatingPlayer.Character and spectatingPlayer.Character:FindFirstChild("Humanoid") or humanoid end
end)
